# Copy this file to .env and replace the placeholder values for local use.
# Production installations normally generate .env through deploy/setup.sh.

WG_HOST=YOUR_SERVER_IP_OR_DOMAIN
PORT=8888
WG_PORT=51820
DEBUG=false

# Native Prometheus endpoint (disabled by default).
METRICS_ENABLED=false
METRICS_CONNECTED_PEER_THRESHOLD=180s
# These values are imported once; subsequent changes are made in Settings > Metrics.
METRICS_HISTORY_ENABLED=true
# Set a long random value to require Authorization: Bearer <token>.
# METRICS_TOKEN=
