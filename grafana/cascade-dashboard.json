{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping Cascade /metrics endpoints",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Fleet monitoring for Cascade VPN and AmneziaWG using Cascade's native Prometheus metrics.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Healthy selected Cascade targets compared with all selected targets.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }, "showPercentChange": false, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "11.0.0",
      "targets": [
        { "editorMode": "code", "expr": "count(cascade_database_up{instance=~\"$instance\"} == 1)", "instant": true, "legendFormat": "Healthy", "range": false, "refId": "A" },
        { "editorMode": "code", "expr": "count(cascade_build_info{instance=~\"$instance\"})", "instant": true, "legendFormat": "Selected", "range": false, "refId": "B" }
      ],
      "title": "Cascade Instances",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 3, "x": 4, "y": 1 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(cascade_interface_up{instance=~\"$instance\",interface=~\"$interface\"})", "instant": true, "legendFormat": "Up", "range": false, "refId": "A" }],
      "title": "Interfaces Up",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 3, "x": 7, "y": 1 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(cascade_peers{instance=~\"$instance\"})", "instant": true, "legendFormat": "Peers", "range": false, "refId": "A" }],
      "title": "Configured Peers",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }, { "color": "green", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 3, "x": 10, "y": 1 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(cascade_peer_connected{instance=~\"$instance\",interface=~\"$interface\"})", "instant": true, "legendFormat": "Connected", "range": false, "refId": "A" }],
      "title": "Connected Peers",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-GrYlRd" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "bps" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 3, "x": 13, "y": 1 },
      "id": 6,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(cascade_interface_rx_bits_per_second{instance=~\"$instance\",interface=~\"$interface\"})", "instant": true, "legendFormat": "RX", "range": false, "refId": "A" }],
      "title": "Current RX",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-GrYlRd" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }, "unit": "bps" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 3, "x": 16, "y": 1 },
      "id": 7,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "sum(cascade_interface_tx_bits_per_second{instance=~\"$instance\",interface=~\"$interface\"})", "instant": true, "legendFormat": "TX", "range": false, "refId": "A" }],
      "title": "Current TX",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "id": 8,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }, "textMode": "auto", "wideLayout": true },
      "targets": [
        { "editorMode": "code", "expr": "count(cascade_gateway_status{instance=~\"$instance\",gateway=~\"$gateway\"} == 1)", "instant": true, "legendFormat": "Up", "range": false, "refId": "A" },
        { "editorMode": "code", "expr": "count(cascade_gateway_status{instance=~\"$instance\",gateway=~\"$gateway\"})", "instant": true, "legendFormat": "Total", "range": false, "refId": "B" }
      ],
      "title": "Gateways",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 10,
      "panels": [],
      "title": "Cascade Servers",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [{ "options": { "0": { "color": "red", "index": 1, "text": "DOWN" }, "1": { "color": "green", "index": 0, "text": "UP" } }, "type": "value" }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value #A" }, "properties": [{ "id": "displayName", "value": "Database" }] },
          { "matcher": { "id": "byName", "options": "Value #B" }, "properties": [{ "id": "displayName", "value": "Uptime" }, { "id": "unit", "value": "s" }] },
          { "matcher": { "id": "byName", "options": "Value #C" }, "properties": [{ "id": "displayName", "value": "Build" }] }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "id": 11,
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true, "sortBy": [{ "desc": false, "displayName": "instance" }] },
      "targets": [
        { "editorMode": "code", "expr": "cascade_database_up{instance=~\"$instance\"}", "format": "table", "instant": true, "legendFormat": "{{instance}}", "range": false, "refId": "A" },
        { "editorMode": "code", "expr": "cascade_uptime_seconds{instance=~\"$instance\"}", "format": "table", "instant": true, "legendFormat": "{{instance}}", "range": false, "refId": "B" },
        { "editorMode": "code", "expr": "cascade_build_info{instance=~\"$instance\"}", "format": "table", "instant": true, "legendFormat": "{{version}} ({{commit}})", "range": false, "refId": "C" }
      ],
      "title": "Cascade Fleet Status",
      "transformations": [{ "id": "merge", "options": {} }, { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true }, "indexByName": {}, "renameByName": { "commit": "Commit", "instance": "Instance", "version": "Version" } } }],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 20,
      "panels": [],
      "title": "Interfaces",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value #A" }, "properties": [{ "id": "displayName", "value": "Up" }, { "id": "mappings", "value": [{ "options": { "0": { "color": "red", "index": 1, "text": "DOWN" }, "1": { "color": "green", "index": 0, "text": "UP" } }, "type": "value" }] }] },
          { "matcher": { "id": "byName", "options": "Value #B" }, "properties": [{ "id": "displayName", "value": "Enabled" }, { "id": "mappings", "value": [{ "options": { "0": { "text": "Disabled" }, "1": { "text": "Enabled" } }, "type": "value" }] }] },
          { "matcher": { "id": "byName", "options": "/Value #[GH]/" }, "properties": [{ "id": "unit", "value": "bytes" }] },
          { "matcher": { "id": "byName", "options": "/Value #[EF]/" }, "properties": [{ "id": "unit", "value": "bps" }] }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 15 },
      "id": 21,
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true, "sortBy": [{ "desc": false, "displayName": "Instance" }] },
      "targets": [
        { "editorMode": "code", "expr": "cascade_interface_up{instance=~\"$instance\",interface=~\"$interface\"}", "format": "table", "instant": true, "refId": "A" },
        { "editorMode": "code", "expr": "cascade_interface_enabled{instance=~\"$instance\",interface=~\"$interface\"}", "format": "table", "instant": true, "refId": "B" },
        { "editorMode": "code", "expr": "cascade_interface_peers{instance=~\"$instance\",interface=~\"$interface\"}", "format": "table", "instant": true, "refId": "C" },
        { "editorMode": "code", "expr": "cascade_interface_peers_connected{instance=~\"$instance\",interface=~\"$interface\"}", "format": "table", "instant": true, "refId": "D" },
        { "editorMode": "code", "expr": "cascade_interface_rx_bits_per_second{instance=~\"$instance\",interface=~\"$interface\"}", "format": "table", "instant": true, "refId": "E" },
        { "editorMode": "code", "expr": "cascade_interface_tx_bits_per_second{instance=~\"$instance\",interface=~\"$interface\"}", "format": "table", "instant": true, "refId": "F" },
        { "editorMode": "code", "expr": "cascade_interface_received_bytes_total{instance=~\"$instance\",interface=~\"$interface\"}", "format": "table", "instant": true, "refId": "G" },
        { "editorMode": "code", "expr": "cascade_interface_sent_bytes_total{instance=~\"$instance\",interface=~\"$interface\"}", "format": "table", "instant": true, "refId": "H" },
        { "editorMode": "code", "expr": "cascade_interface_listen_port{instance=~\"$instance\",interface=~\"$interface\"}", "format": "table", "instant": true, "refId": "I" },
        { "editorMode": "code", "expr": "cascade_interface_info{instance=~\"$instance\",interface=~\"$interface\"}", "format": "table", "instant": true, "refId": "J" }
      ],
      "title": "Interface Status",
      "transformations": [{ "id": "merge", "options": {} }, { "id": "organize", "options": { "excludeByName": { "Time": true, "__name__": true, "job": true }, "indexByName": {}, "renameByName": { "Value #C": "Peers", "Value #D": "Connected", "Value #E": "RX Rate", "Value #F": "TX Rate", "Value #G": "RX Total", "Value #H": "TX Total", "Value #I": "Listen Port", "instance": "Instance", "interface": "Interface", "name": "Name", "protocol": "Protocol" } } }],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 30,
      "panels": [],
      "title": "Traffic",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 12, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "insertNulls": false, "lineInterpolation": "smooth", "lineWidth": 2, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "bps" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 26 },
      "id": 31,
      "options": { "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(cascade_interface_rx_bits_per_second{instance=~\"$instance\",interface=~\"$interface\"})", "legendFormat": "RX", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(cascade_interface_tx_bits_per_second{instance=~\"$instance\",interface=~\"$interface\"})", "legendFormat": "TX", "range": true, "refId": "B" }
      ],
      "title": "Aggregate Traffic Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 8, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "bps" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 26 },
      "id": 32,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "cascade_interface_rx_bits_per_second{instance=~\"$instance\",interface=~\"$interface\"}", "legendFormat": "{{instance}} / {{interface}} RX", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "cascade_interface_tx_bits_per_second{instance=~\"$instance\",interface=~\"$interface\"}", "legendFormat": "{{instance}} / {{interface}} TX", "range": true, "refId": "B" }
      ],
      "title": "Throughput per Interface",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Top peers by five-minute receive rate. Traffic counters are converted to bits per second with rate().",
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-GrYlRd" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "bps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "id": 33,
      "options": { "displayMode": "gradient", "maxVizHeight": 300, "minVizHeight": 16, "minVizWidth": 8, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }, "showUnfilled": true, "sizing": "auto", "valueMode": "color" },
      "targets": [{ "editorMode": "code", "expr": "topk(10, sum by (instance, interface, peer_id, name) (rate(cascade_peer_received_bytes_total{instance=~\"$instance\",interface=~\"$interface\",peer_id=~\"$peer_id\"}[5m])) * 8)", "instant": true, "legendFormat": "{{instance}} / {{interface}} / {{name}}", "range": false, "refId": "A" }],
      "title": "Top Peers by RX Rate",
      "type": "bargauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "Top peers by five-minute transmit rate.",
      "fieldConfig": { "defaults": { "color": { "mode": "continuous-BlPu" }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }, "unit": "bps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "id": 34,
      "options": { "displayMode": "gradient", "maxVizHeight": 300, "minVizHeight": 16, "minVizWidth": 8, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": true }, "showUnfilled": true, "sizing": "auto", "valueMode": "color" },
      "targets": [{ "editorMode": "code", "expr": "topk(10, sum by (instance, interface, peer_id, name) (rate(cascade_peer_sent_bytes_total{instance=~\"$instance\",interface=~\"$interface\",peer_id=~\"$peer_id\"}[5m])) * 8)", "instant": true, "legendFormat": "{{instance}} / {{interface}} / {{name}}", "range": false, "refId": "A" }],
      "title": "Top Peers by TX Rate",
      "type": "bargauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "id": 40,
      "panels": [],
      "title": "Peers",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false }, "mappings": [], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value #A" }, "properties": [{ "id": "displayName", "value": "Connected" }, { "id": "mappings", "value": [{ "options": { "0": { "color": "red", "index": 1, "text": "Offline" }, "1": { "color": "green", "index": 0, "text": "Online" } }, "type": "value" }] }] },
          { "matcher": { "id": "byName", "options": "Value #B" }, "properties": [{ "id": "displayName", "value": "Enabled" }, { "id": "mappings", "value": [{ "options": { "0": { "text": "Disabled" }, "1": { "text": "Enabled" } }, "type": "value" }] }] },
          { "matcher": { "id": "byName", "options": "/Value #[CD]/" }, "properties": [{ "id": "unit", "value": "bytes" }] },
          { "matcher": { "id": "byName", "options": "Value #E" }, "properties": [{ "id": "unit", "value": "s" }] },
          { "matcher": { "id": "byName", "options": "Value #F" }, "properties": [{ "id": "unit", "value": "dateTimeAsIso" }] }
        ]
      },
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 44 },
      "id": 41,
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true, "sortBy": [{ "desc": false, "displayName": "Instance" }] },
      "targets": [
        { "editorMode": "code", "expr": "cascade_peer_connected{instance=~\"$instance\",interface=~\"$interface\",peer_id=~\"$peer_id\"}", "format": "table", "instant": true, "refId": "A" },
        { "editorMode": "code", "expr": "cascade_peer_enabled{instance=~\"$instance\",interface=~\"$interface\",peer_id=~\"$peer_id\"}", "format": "table", "instant": true, "refId": "B" },
        { "editorMode": "code", "expr": "cascade_peer_received_bytes_total{instance=~\"$instance\",interface=~\"$interface\",peer_id=~\"$peer_id\"}", "format": "table", "instant": true, "refId": "C" },
        { "editorMode": "code", "expr": "cascade_peer_sent_bytes_total{instance=~\"$instance\",interface=~\"$interface\",peer_id=~\"$peer_id\"}", "format": "table", "instant": true, "refId": "D" },
